{
  "@@locale": "en",
  "appTitle": "Social Commerce Discovery Platform",
  "@appTitle": {
    "description": "Application title shown in the OS task switcher."
  },
  "relativeJustNow": "just now",
  "@relativeJustNow": {
    "description": "Relative time shown for something that happened less than a minute ago."
  },
  "relativeMinutesAgo": "{count, plural, one{{count} minute ago} other{{count} minutes ago}}",
  "@relativeMinutesAgo": {
    "description": "Relative time in minutes (1 to 59).",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "relativeHoursAgo": "{count, plural, one{{count} hour ago} other{{count} hours ago}}",
  "@relativeHoursAgo": {
    "description": "Relative time in hours (1 to 23).",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "relativeDaysAgo": "{count, plural, one{{count} day ago} other{{count} days ago}}",
  "@relativeDaysAgo": {
    "description": "Relative time in days (1 to 6).",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "errorNetwork": "No connection. Check your internet and try again.",
  "@errorNetwork": {
    "description": "Shown when the request could not reach the server (offline, timeout, DNS)."
  },
  "errorSecureConnection": "A secure connection to the server could not be established.",
  "@errorSecureConnection": {
    "description": "Shown when the TLS certificate check fails."
  },
  "errorServer": "Something went wrong on our end. Please try again later.",
  "@errorServer": {
    "description": "Shown for server-side failures (HTTP 5xx)."
  },
  "errorAuthentication": "We could not verify your identity. Please sign in again.",
  "@errorAuthentication": {
    "description": "Backend code AUTHENTICATION_FAILED (missing, expired or invalid credentials)."
  },
  "errorNotAuthorized": "You are not allowed to do that.",
  "@errorNotAuthorized": {
    "description": "Generic 401/403 without a backend code."
  },
  "errorPermissionDenied": "You do not have permission to do that.",
  "@errorPermissionDenied": {
    "description": "Backend code PERMISSION_DENIED."
  },
  "errorNotFound": "We could not find what you were looking for.",
  "@errorNotFound": {
    "description": "Backend code NOT_FOUND."
  },
  "errorBadRequest": "That request could not be completed.",
  "@errorBadRequest": {
    "description": "Backend codes METHOD_NOT_ALLOWED, NOT_ACCEPTABLE, UNSUPPORTED_MEDIA_TYPE, PARSE_ERROR."
  },
  "errorValidation": "Some of the information you entered could not be accepted. Please check it and try again.",
  "@errorValidation": {
    "description": "Backend code VALIDATION_ERROR when no field-level text is shown."
  },
  "errorThrottled": "Too many attempts in a short time. Please wait a moment and try again.",
  "@errorThrottled": {
    "description": "Backend code THROTTLED (rate limit)."
  },
  "errorConflict": "This item has already changed. Refresh and try again.",
  "@errorConflict": {
    "description": "Backend code CONFLICT (state conflict, e.g. already moderated)."
  },
  "errorServiceUnavailable": "This service is not available right now. Please try again later.",
  "@errorServiceUnavailable": {
    "description": "Backend code SERVICE_UNAVAILABLE."
  },
  "errorCancelled": "The request was cancelled.",
  "@errorCancelled": {
    "description": "The request was cancelled on the device."
  },
  "errorUnknown": "An unexpected error occurred. Please try again.",
  "@errorUnknown": {
    "description": "Fallback when nothing more specific is known."
  },
  "compactThousands": "{value}K",
  "@compactThousands": {
    "description": "Compact count in thousands, e.g. 12.4K followers. {value} is already formatted text with Western digits.",
    "placeholders": {
      "value": {
        "type": "String"
      }
    }
  },
  "compactMillions": "{value}M",
  "@compactMillions": {
    "description": "Compact count in millions, e.g. 1.2M.",
    "placeholders": {
      "value": {
        "type": "String"
      }
    }
  },
  "compactBillions": "{value}B",
  "@compactBillions": {
    "description": "Compact count in billions, e.g. 2.5B.",
    "placeholders": {
      "value": {
        "type": "String"
      }
    }
  },
  "monthName": "{month, select, january{January} february{February} march{March} april{April} may{May} june{June} july{July} august{August} september{September} october{October} november{November} december{December} other{{month}}}",
  "@monthName": {
    "description": "Full month name. The argument is a lower-case English month key (january ... december).",
    "placeholders": {
      "month": {
        "type": "String"
      }
    }
  },
  "dateFull": "{month} {day}, {year}",
  "@dateFull": {
    "description": "Absolute date. day and year are plain Western-digit text, month is the localized month name.",
    "placeholders": {
      "day": {
        "type": "String"
      },
      "month": {
        "type": "String"
      },
      "year": {
        "type": "String"
      }
    }
  },
  "dateAndTime": "{date}, {time}",
  "@dateAndTime": {
    "description": "A date and a clock time written together.",
    "placeholders": {
      "date": {
        "type": "String"
      },
      "time": {
        "type": "String"
      }
    }
  },
  "currencyLabel": "{currency, select, egp{EGP} sar{SAR} aed{AED} jod{JOD} other{{currency}}}",
  "@currencyLabel": {
    "description": "Short currency label shown next to a price. The argument is a lower-case ISO code of a supported currency.",
    "placeholders": {
      "currency": {
        "type": "String"
      }
    }
  },
  "priceDisplay": "{amount} {currency}",
  "@priceDisplay": {
    "description": "A price: amount (already grouped, Western digits) and the short currency label. For discovery display only.",
    "placeholders": {
      "amount": {
        "type": "String"
      },
      "currency": {
        "type": "String"
      }
    }
  }
}
